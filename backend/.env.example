# Copy to .env and fill in. Never commit real secrets.

# --- core ---
CAREER_AI_ENV=development            # development | production
CAREER_AI_SECRET=change-me-with-a-long-random-string
CAREER_AI_ADMIN_TOKEN=               # required in production; auto-generated in dev (.admin_token)
CAREER_AI_CORS_ORIGINS=http://localhost:8090,http://127.0.0.1:8090
CAREER_AI_DB=                        # path to SQLite file (default: backend/career_ai.db)

# --- background scheduler (periodic scrape + RGPD purge) ---
CAREER_AI_SCHEDULER=0                # 1 to enable
CAREER_AI_REFRESH_SEC=21600          # every 6h
CAREER_AI_JOB_RETENTION_DAYS=30
CAREER_AI_CONTACT_RETENTION_DAYS=365

# --- email notifications (placement / access requests) ---
ADMIN_EMAIL=bancmaha@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASSWORD=app-password-here      # Gmail: app password, not your login password
SMTP_FROM=

# --- optional job sources (self-disable when empty) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=fr
FT_CLIENT_ID=
FT_CLIENT_SECRET=
